# =======================================================
# 1. 大语言模型基础配置 (LLM Basic Configuration)
# =======================================================
# 请替换为您的实际大模型 API 密钥
AGENT_LLM_API_KEY=your_llm_api_key_here

# 大模型接口地址（兼容 OpenAI 协议）
AGENT_LLM_BASE_URL=https://api.deepseek.com

# 目标大模型名称
# 系统支持通过修改此参数进行动态切换
AGENT_LLM_MODEL=deepseek-v4-flash[1m]

# 模型最大输出限制（单位：Tokens）
AGENT_LLM_MAX_TOKENS=4096

# 模型思考等级 / 推理努力度 (Reasoning Effort)
# 支持的值: low, medium, high (默认), max (最高强度), disabled (关闭)
AGENT_LLM_REASONING_EFFORT=high


# =======================================================
# 2. 大语言模型高级控制与网络参数 (LLM Advanced & Network Configuration)
# =======================================================
# 上下文窗口限制 (支持如 1m、128k 缩写，覆写模型名且缺失此项时将自动退化为保守的 32000 Tokens)
# AGENT_LLM_CONTEXT_WINDOW=1m

# 采样温度限制 (默认使用模型内置预设，如 0.2)
# AGENT_LLM_TEMPERATURE=0.2

# 网络请求超时限制（单位：毫秒，默认 600000 毫秒即 10 分钟）
# AGENT_LLM_TIMEOUT=600000

# 网络请求最大重试次数（默认 3 次）
# AGENT_LLM_MAX_RETRIES=3

# 自定义 HTTP 请求头（格式为 Key:Value，多项可用换行或分号分隔，常用于代理网关校验）
# AGENT_LLM_HEADERS=X-Custom-Gateway-Key:your_gateway_auth_token


# =======================================================
# 3. 文本嵌入模型配置 (Text Embedding Configuration)
# =======================================================
# 文本嵌入 API 密钥 (可选，缺省时降级复用 AGENT_LLM_API_KEY)
# AGENT_EMBEDDING_API_KEY=your_embedding_api_key_here

# 文本嵌入接口地址 (可选，缺省时降级复用 AGENT_LLM_BASE_URL)
# AGENT_EMBEDDING_BASE_URL=https://api.deepseek.com

# 目标文本嵌入模型名称 (默认 text-embedding-3-small)
# AGENT_EMBEDDING_MODEL=text-embedding-3-small


# =======================================================
# 4. 智能体执行限制与运行防洪控制 (Agent Loop & Runtime Limits)
# =======================================================
# 大模型在一次对话中允许流转调用工具的最大迭代轮数限制（默认 20 轮）
# AGENT_MAX_ITERATIONS=20

# Token 水位自动压缩阈值比例（浮点型，默认 0.8 即 80%）
# AGENT_COMPACTION_WATERMARK_FACTOR=0.8


# =======================================================
# 5. 工具防爆与读取限制 (Agent Tool Volume Limits)
# =======================================================
# 工具返回的文本结果长度截断落盘阈值（单位：字符，默认 8000）
# AGENT_LARGE_TOOL_OUTPUT_LIMIT=8000

# 批量读取文件体积安全熔断阈值（单位：字符，默认 50000）
# AGENT_READ_MANY_FILES_LIMIT=50000

# 文件与文本全文检索展示的匹配结果最大条数（默认 100 条）
# AGENT_SEARCH_LIMIT=100


# =======================================================
# 6. 第三方工具与运行模式配置 (Third-Party & Execution Mode Configuration)
# =======================================================
# 终端安全执行工作模式 (可选，支持 Safe, Auto, YOLO，默认为 Auto)
# Safe: 强制每次确认；Auto: 匹配白名单则放行；YOLO: 直接放行所有命令
# AGENT_WORK_MODE=Auto

# Tavily 搜索 API 密钥（用于 MCP 搜索工具，可选）
# 配置后可在 mcp_config.json 中通过 ${TAVILY_API_KEY} 引用
TAVILY_API_KEY=your_tavily_api_key_here





