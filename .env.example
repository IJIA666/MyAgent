# DeepSeek API Configuration
# Replace with your actual DeepSeek API key
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# DeepSeek official endpoint (OpenAI compatible)
DEEPSEEK_API_URL=https://api.deepseek.com/v1

# Target DeepSeek model (e.g., deepseek-chat, deepseek-coder)
# The system supports dynamic switching by changing this parameter
DEEPSEEK_MODEL=deepseek-chat

# Authorized workspace path (defaults to the current working directory of the application)
# All file operations (readFile, writeFile, listFiles) will be sandboxed to this path
AUTHORIZED_WORKSPACE_DIR=.
