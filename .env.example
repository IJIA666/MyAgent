# DeepSeek API 配置
# 请替换为您的实际 DeepSeek API 密钥
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# DeepSeek 官方接口地址（兼容 OpenAI）
DEEPSEEK_API_URL=https://api.deepseek.com/v1

# 目标 DeepSeek 模型（例如：deepseek-chat, deepseek-coder）
# 系统支持通过修改此参数进行动态切换
DEEPSEEK_MODEL=deepseek-chat

# 授权的工作区路径（默认为应用程序的当前工作目录）
# 所有文件操作（readFile, writeFile, listFiles）都将被限制在此路径下的沙箱中
AUTHORIZED_WORKSPACE_DIR=.

