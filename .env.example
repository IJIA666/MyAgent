# =======================================================
# 1. 大语言模型基础配置 (LLM Basic Configuration)
# =======================================================
# 请替换为您的实际大模型 API 密钥
AGENT_LLM_API_KEY=your_llm_api_key_here

# 大模型接口地址（兼容 OpenAI 协议）
AGENT_LLM_BASE_URL=https://api.deepseek.com

# 目标大模型名称
# 系统支持通过修改此参数进行动态切换
AGENT_LLM_MODEL=deepseek-v4-flash[1m]

# 模型最大输出限制（单位：Tokens）
AGENT_LLM_MAX_TOKENS=4096

# 模型思考等级 / 推理努力度 (Reasoning Effort)
# 支持的值: low, medium, high (默认), max (最高强度), disabled (关闭)
AGENT_LLM_REASONING_EFFORT=high

# 用户可见回复的偏好语言（可选；未配置时不向模型施加语言要求）
# AGENT_LANGUAGE=简体中文


# =======================================================
# 2. 大语言模型高级控制与网络参数 (LLM Advanced & Network Configuration)
# =======================================================
# 上下文窗口限制 (支持如 1m、128k 缩写，覆写模型名且缺失此项时将自动退化为保守的 32000 Tokens)
# AGENT_LLM_CONTEXT_WINDOW=1m

# 采样温度限制 (默认使用模型内置预设，如 0.2)
# AGENT_LLM_TEMPERATURE=0.2

# 网络请求超时限制（单位：毫秒，默认 600000 毫秒即 10 分钟）
# AGENT_LLM_TIMEOUT=600000

# 网络请求最大重试次数（默认 3 次）
# AGENT_LLM_MAX_RETRIES=3

# 自定义 HTTP 请求头（格式为 Key:Value，多项可用换行或分号分隔，常用于代理网关校验）
# AGENT_LLM_HEADERS=X-Custom-Gateway-Key:your_gateway_auth_token


# =======================================================
# 3. 智能体执行限制与运行防洪控制 (Agent Loop & Runtime Limits)
# =======================================================
# 大模型在一次对话中允许流转调用工具的最大迭代轮数限制（默认 20 轮）
# AGENT_MAX_ITERATIONS=20

# Token 水位自动压缩阈值比例（浮点型，默认 0.8 即 80%）
# AGENT_COMPACTION_WATERMARK_FACTOR=0.8

# AgentLoop 单次模型调用超时（单位：毫秒，默认 60000 即 60 秒）
# 控制 AgentLoop 在单次模型请求外层创建的取消时限，与上方 AGENT_LLM_TIMEOUT（网络层超时）不同边界
# AGENT_MODEL_TIMEOUT_MS=60000

# 子代理同时运行上限（默认 4）
# AGENT_SUBAGENT_MAX_CONCURRENT=4

# 子代理在途任务上限（默认 16，必须大于等于同时运行上限）
# AGENT_SUBAGENT_MAX_IN_FLIGHT=16

# 前台子代理自动转后台的等待时长（毫秒，默认 0 表示关闭）
# AGENT_SUBAGENT_AUTO_BACKGROUND_MS=0

# 是否启用省略 subagent_type 即 exact-fork 的语义（默认 false）
# AGENT_SUBAGENT_FORK_ENABLED=false


# =======================================================
# 4. 诊断数据治理 (Diagnostic Data Governance)
# =======================================================
# 默认启用 operational/audit，默认关闭 replay。
# replay 会把 prompt、上下文、reasoning、工具参数和结果短期写入 trace，请仅在受控排障场景开启。
# AGENT_DIAGNOSTIC_REPLAY=false

# 用户追加的脱敏正则，必须是 JSON 字符串数组；非法 pattern 会被忽略且不会回显原文。
# AGENT_DIAGNOSTIC_PATTERNS=["customer-secret-[0-9]+","internal-token"]

# trace/audit 默认各保留最近 7 天、最多 20 个会话文件；可收紧或放宽，但上限为 30 天、100 个文件。
# AGENT_TRACE_RETENTION_DAYS=7
# AGENT_TRACE_RETENTION_SESSIONS=20
# AGENT_AUDIT_RETENTION_DAYS=7
# AGENT_AUDIT_RETENTION_SESSIONS=20



# 同一工具完全相同参数允许的最大调用次数以防止死循环熔断（默认 3）
# AGENT_LOOP_PREVENTION_LIMIT=3

# 中段压缩时最多原样保留的最新完整对话轮数（默认 4）
# AGENT_COMPACTION_RETAIN_COUNT=4

# 中段压缩时原样保留最新完整轮次的 Token 预算；最新一轮始终完整保留（默认 8000）
# AGENT_COMPACTION_RETAIN_TOKENS=8000

# 中段历史摘要的最大输出 Token 数（默认 4096）
# AGENT_COMPACTION_SUMMARY_MAX_TOKENS=4096


# =======================================================
# 5. 工具防爆与读取限制 (Agent Tool Volume Limits)
# =======================================================
# 工具返回的文本结果长度截断落盘阈值（单位：字符，默认 8000）
# AGENT_LARGE_TOOL_OUTPUT_LIMIT=8000

# 批量读取文件体积安全熔断阈值（单位：字符，默认 50000）
# AGENT_READ_MANY_FILES_LIMIT=50000

# 文件与文本全文检索展示的匹配结果最大条数（默认 100 条）
# AGENT_SEARCH_LIMIT=100


# =======================================================
# 6. 第三方工具与运行模式配置 (Third-Party & Execution Mode Configuration)
# =======================================================
# 终端安全执行工作模式 (可选，支持 Safe, Auto, YOLO，默认为 Auto)
# Safe: 强制每次确认；Auto: 匹配白名单则放行；YOLO: 直接放行所有命令
# AGENT_WORK_MODE=Auto

# 是否开启只读 Plan 模式下的敏感修改工具（securityCategory: 'write'）物理裁剪过滤（布尔型，默认 false）
# 开启后，在 Plan 模式下将自动排除所有写倾向工具声明以提供最高级别防线，但切换模式会破坏 Context Cache。
# ENABLE_PLAN_TOOL_STRIPPING=false

# Tavily 搜索 API 密钥（用于 MCP 搜索工具，可选）
# 配置后可在 mcp_config.json 中通过 ${TAVILY_API_KEY} 引用
TAVILY_API_KEY=your_tavily_api_key_here





