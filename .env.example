# DeepSeek API 配置
# 请替换为您的实际 DeepSeek API 密钥
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# DeepSeek 官方接口地址（兼容 OpenAI 协议）
DEEPSEEK_API_URL=https://api.deepseek.com

# 目标 DeepSeek 模型
# 系统支持通过修改此参数进行动态切换
DEEPSEEK_MODEL=deepseek-v4-flash

# 模型思考等级 (Reasoning Effort)
# 支持的值: high (默认), max (最高强度，适合复杂 Agent), disabled (关闭)
DEEPSEEK_REASONING_EFFORT=high

# 授权的工作区路径（默认为应用程序的当前工作目录）
# 所有文件操作（readFile, writeFile, listFiles）都将被限制在此路径下的沙箱中
AUTHORIZED_WORKSPACE_DIR=.

# Tavily 搜索 API 密钥（用于 MCP 搜索工具，可选）
# 配置后可在 mcp_config.json 中通过 ${TAVILY_API_KEY} 引用
TAVILY_API_KEY=your_tavily_api_key_here
