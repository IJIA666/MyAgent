# DeepSeek API 配置
# 请替换为您的实际 DeepSeek API 密钥
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# DeepSeek 官方接口地址（兼容 OpenAI 协议）
DEEPSEEK_API_URL=https://api.deepseek.com

# 目标 DeepSeek 模型
# 系统支持通过修改此参数进行动态切换
DEEPSEEK_MODEL=deepseek-v4-flash[1m]

# 模型最大输出限制
DEEPSEEK_MAX_TOKENS=4096

# 模型思考等级 (Reasoning Effort)
# 支持的值: high (默认), max (最高强度，适合复杂 Agent), disabled (关闭)
DEEPSEEK_REASONING_EFFORT=high

# 授权的工作区路径（默认为应用程序的当前工作目录）
# 所有文件操作（readFile, writeFile, listFiles）都将被限制在此路径下的沙箱中
AUTHORIZED_WORKSPACE_DIR=.

# Tavily 搜索 API 密钥（用于 MCP 搜索工具，可选）
# 配置后可在 mcp_config.json 中通过 ${TAVILY_API_KEY} 引用
TAVILY_API_KEY=your_tavily_api_key_here

# 大模型高级配置与网络覆写 (可选，若不配置则使用内置默认值)
# =======================================================
# 上下文窗口限制 (支持如 1m、128k 缩写，覆写模型名且缺失此项时将自动退化为保守的 32000 tokens)
# DEEPSEEK_CONTEXT_WINDOW=1m

# 采样温度限制 (默认使用模型内置预设，如 0.2)
# DEEPSEEK_TEMPERATURE=0.2

# 网络请求超时限制（单位：毫秒，默认 600000 毫秒即 10 分钟）
# DEEPSEEK_TIMEOUT=600000

# 网络请求最大重试次数（默认 3 次）
# DEEPSEEK_MAX_RETRIES=3

# 自定义 HTTP 请求头（格式为 Key:Value，多项可用换行或分号分隔，常用于代理网关校验）
# DEEPSEEK_HEADERS=X-Custom-Gateway-Key:your_gateway_auth_token

# 终端安全执行工作模式 (可选，支持 Safe, Auto, YOLO，默认为 Auto)
# Safe: 强制每次确认；Auto: 匹配白名单则放行；YOLO: 直接放行所有命令
# AGENT_WORK_MODE=Auto


