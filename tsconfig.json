{
  "compilerOptions": {
    "target": "ES2022", /* 指定 ECMAScript 目标版本 */
    "module": "NodeNext", /* 指定模块代码生成方式 */
    "moduleResolution": "NodeNext", /* 指定模块解析策略 */
    "esModuleInterop": true, /* 允许 CommonJS 和 ES Modules 之间的互相调用 */
    "forceConsistentCasingInFileNames": true, /* 强制在文件名中使用一致的大小写 */
    "strict": true, /* 启用所有严格的类型检查选项 */
    "skipLibCheck": true, /* 跳过对声明文件的类型检查 */
    "outDir": "./dist", /* 将输出结构重定向到该目录 */
    "rootDir": "./src", /* 指定输入文件的根目录 */
    "resolveJsonModule": true /* 允许导入 .json 文件 */
  },
  "include": [
    "src/**/*",
    "src/config.ts"
  ]
}